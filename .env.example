# Backend API Configuration
NEXT_PUBLIC_API_PROXY_TARGET=http://localhost:8082
NEXT_PUBLIC_API_BASE_URL=/api/v1

# WebSocket Configuration
NEXT_PUBLIC_WS_ENDPOINT=/ws
NEXT_PUBLIC_SUB_DEST=/user/queue/noti

# Google OAuth Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Node Environment
NODE_ENV=production

# Instructions:
# 1. Copy this file to .env
#    cp .env.example .env
#
# 2. Update the values according to your environment:
#    - For development: use localhost URLs
#    - For production: use your production API endpoints
#
# 3. IMPORTANT: Never commit .env file to git
#    The .env file contains sensitive information
